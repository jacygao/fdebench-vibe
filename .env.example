# OpenAI or an OpenAI-compatible HTTPS chat-completions endpoint.
TRIAGE_LLM_URL=https://api.openai.com/v1/chat/completions
TRIAGE_LLM_API_KEY=
TRIAGE_LLM_MODEL=gpt-4.1-mini
TRIAGE_LLM_AUTH=bearer
TRIAGE_LLM_TIMEOUT_SECONDS=8
TRIAGE_LLM_ATTEMPTS=2
TRIAGE_REQUEST_TIMEOUT_SECONDS=20
TRIAGE_MAX_CONCURRENT_MODELS=16
# A vision-capable model on the same endpoint, independently selectable.
TRIAGE_EXTRACT_MODEL=gpt-4.1-mini
TRIAGE_EXTRACT_TIMEOUT_SECONDS=45
TRIAGE_EXTRACT_MODEL_TIMEOUT_SECONDS=15
TRIAGE_MAX_CONCURRENT_EXTRACTIONS=4
# Capable planner on the shared model endpoint. No task-level automatic retries.
TRIAGE_ORCHESTRATE_MODEL=gpt-4.1
TRIAGE_ORCHESTRATE_TIMEOUT_SECONDS=55
TRIAGE_ORCHESTRATE_MODEL_TIMEOUT_SECONDS=8
TRIAGE_ORCHESTRATE_MAX_ROUNDS=12
TRIAGE_ORCHESTRATE_MAX_STEPS=64
TRIAGE_MAX_CONCURRENT_WORKFLOWS=8
TRIAGE_TOOL_TIMEOUT_SECONDS=5
TRIAGE_TOOL_ATTEMPTS=2
# Exact origins only. For a local benchmark mock, add its actual origin to BOTH
# lists explicitly. Never enable broad private-network or wildcard URL access.
TRIAGE_TOOL_ALLOWED_ORIGINS=["https://tools.fdebench.dev"]
TRIAGE_TOOL_PRIVATE_ORIGINS=[]
TRIAGE_TOOL_READ_ONLY_NAMES=["crm_search","crm_get_account","subscription_check","calendar_check","inventory_query"]
TRIAGE_TOOL_IDEMPOTENT_NAMES=[]
# All instances of the same deployment must share this durable Redis store.
TRIAGE_REDIS_URL=redis://127.0.0.1:6379/0
# For Azure, use your full HTTPS deployment chat/completions URL, including
# api-version if required, and set TRIAGE_LLM_AUTH=api-key.
# Optional USD prices per million tokens, used only for estimated cost headers.
# TRIAGE_INPUT_PRICE_PER_MILLION=0.40
# TRIAGE_OUTPUT_PRICE_PER_MILLION=1.60
